{
  "buildCommand": "node scripts/build-hosted-qa.cjs",
  "outputDirectory": "build",
  "functions": { "api/qa-socket.js": { "maxDuration": 60 } },
  "framework": "create-react-app",
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/socket.io/:path*", "destination": "/api/qa-socket" },
    { "source": "/api/:path*", "destination": "/api/qa-proxy?__qa_path=:path*" },
    {
      "source": "/crm-leads",
      "destination": "/crm.html"
    }
  ]
}
